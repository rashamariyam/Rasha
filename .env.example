# =============================================
#  LeaveEase – Environment Variables Template
#  Copy this to .env and fill in your values.
#  This file IS safe to commit to git.
# =============================================

# --- MongoDB ---
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/leaveease?retryWrites=true&w=majority

# --- Server ---
PORT=5000
NODE_ENV=development

# --- JWT Secret ---
JWT_SECRET=replace_with_64_plus_char_random_string
JWT_EXPIRES_IN=7d

# --- CORS ---
FRONTEND_URL=http://localhost:5173
